# ============================================================
# Research Intelligence Assistant — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file — it's already in .gitignore.
# ============================================================

# --- Claude API (required for real extraction; get a key at console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Two-tier model split: Haiku does cheap relevance tagging, Sonnet does synthesis.
CLAUDE_TAG_MODEL=claude-haiku-4-5-20251001
CLAUDE_SYNTHESIS_MODEL=claude-sonnet-5

# --- Database ---
# SQLite is fine for local dev/demo. Point at Postgres for production
# (e.g. postgresql://user:password@host:5432/via).
DATABASE_URL=sqlite:///via.db

# --- Vector store ---
# Local persistent Chroma directory. Swap for a hosted vector DB in production
# if you need multi-instance deployment (the VectorIndex class is the only
# place that would need to change).
CHROMA_PATH=./chroma_store

# --- Embeddings ---
# "tfidf" = free, offline, deterministic — good for dev/demo, no API key needed.
# Swap in a real embedding provider (OpenAI text-embedding-3, Voyage, or a
# local sentence-transformers model) for production-quality retrieval by
# implementing BaseEmbeddingProvider in core/embeddings.py.
EMBEDDING_PROVIDER=tfidf
OPENAI_API_KEY=

# --- Chunking / retrieval tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=6

# --- Usage safety net ---
# Hard cap on Claude-calling extraction runs (briefs + monitor calls) per
# rolling 24h window, across all users of this deployment. Prevents a
# runaway test loop or repeated form submissions from silently burning
# through a large token/dollar budget unattended. This is a backstop only —
# set an actual spend limit in the Anthropic Console (Settings -> Limits)
# as the authoritative cap.
MAX_DAILY_EXTRACTIONS=50

# --- SEC EDGAR ---
# SEC requires a descriptive User-Agent with a real contact email on every
# request, or it will block you. Replace with your own info.
EDGAR_USER_AGENT=ResearchIntelligenceAssistant your-email@example.com

# --- Optional: Slack alerting via n8n webhook when a new signal is flagged ---
N8N_WEBHOOK_URL=

# --- Flask ---
SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=1
PORT=5000
